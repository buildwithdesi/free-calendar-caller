# CallMeBot (Telegram username or +phone after one-time auth)
CALLMEBOT_TELEGRAM_USER=@yourusername
CALLMEBOT_LANG=en-US-Standard-B
CALLMEBOT_REPEAT=2

# Google Calendar OAuth (one set per Gmail, or store tokens in a DB)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN_PERSONAL=
GOOGLE_REFRESH_TOKEN_WORK=

# Optional: timezone for spoken times
TZ_DISPLAY=America/Chicago
